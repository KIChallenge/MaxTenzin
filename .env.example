# Azure AI Foundry (OpenAI-compatible v1 endpoint, Bearer key). Without a key the app runs in offline/fake LLM mode.
AZURE_ACCOUNT_NAME=
AZURE_ENDPOINT_URL=https://<account>.services.ai.azure.com/openai/v1
AZURE_API_KEY=
LLM_MODEL=gpt-5-4-mini
LLM_MODE=auto            # auto | live | fake
RAW_DATA_DIR=docs        # raw challenge data (gitignored), only used by make extract / goldens
